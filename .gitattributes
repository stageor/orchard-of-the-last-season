# Normalise text files so Windows, macOS and CI produce identical input.
* text=auto

*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf

# Unity YAML stays text so diffs and the repository validator can read it.
*.unity text
*.prefab text
*.asset text
*.meta text

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.exe binary
*.wasm binary
*.data binary
*.zip binary
*.gz binary

# Keep generated build output and local Unity data out of language statistics.
Library/** linguist-vendored
Temp/** linguist-vendored
Logs/** linguist-vendored
Build/** linguist-generated
artifacts/** linguist-generated
